#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        sk_shift: sticky_shift {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
        };
    };

    macros {
        del_to_eol: delete_to_end_of_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(RIGHT)) &kp DELETE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB       &kp Q   &kp W  &kp E  &kp R  &kp T                   &kp Y      &kp U  &kp I     &kp O  &kp P  &kp BSPC
&kp LEFT_BRACE  &kp A     &kp S      &kp D    &kp F  &kp G                   &kp H      &kp J  &kp K     &kp L  &kp SEMI  &kp SQT
&kp GRAVE     &kp Z  &kp X      &kp C    &kp V  &kp B                   &kp N      &kp M  &kp COMMA     &kp DOT  &kp FSLH  &kp LBKT
                                   &mo 3    &mo 1  &sk_shift LEFT_SHIFT    &kp SPACE  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp GRAVE         &kp LBKT             &kp LS(W)  &kp LS(E)  &kp LS(LBKT)      &trans          &kp ASTERISK  &kp N7        &kp N8        &kp N9        &kp BACKSLASH  &trans
&kp LS(NUMBER_1)  &kp LS(LBKT)        &kp LS(N9)     &kp LS(N0)   &kp LS(MINUS)      &kp LS(EQUAL)    &kp LBKT     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp RBKT      &kp SQT
&kp LSHFT         &kp LS(EXCLAMATION)  &kp MINUS       &kp EQUAL     &kp LS(NUMBER_1)  &trans          &kp E       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp RIGHT_BRACE       &kp RIGHT_SHIFT
                                                      &trans       &trans            &trans          &trans        &kp N0        &kp ENTER
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&trans     &trans  &trans  &trans  &trans      &trans    &kp LA(UP_ARROW)    &kp LA(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)  &kp LA(RIGHT_ARROW)  &kp LA(DOWN)
&trans     &trans  &trans  &trans  &trans      &trans    &kp LG(LEFT_ARROW)  &kp LEFT_ARROW      &kp DOWN_ARROW      &kp UP_ARROW      &kp RIGHT_ARROW      &kp LG(RIGHT_ARROW)
&kp LSHFT  &trans  &trans  &trans  &trans      &trans    &kp LG(BACKSPACE)   &kp LA(BACKSPACE)   &kp BACKSPACE       &kp DELETE        &kp LA(DELETE)       &del_to_eol
                           &trans  &kp ESCAPE  &trans    &trans              &trans              &trans
            >;
        };

        extra_1 {
            display-name = "Extra1";
            bindings = <
&trans  &trans          &trans            &trans        &trans        &trans    &kp LG(LS(Z))  &kp LG(X)       &kp LG(C)       &kp LG(V)     &kp LG(Z)        &trans
&trans  &sk LEFT_SHIFT  &sk LEFT_CONTROL  &sk LEFT_ALT  &sk LEFT_GUI  &trans    &trans         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans          &trans            &trans        &trans        &trans    &trans         &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                                          &trans        &trans        &trans    &mkp LCLK      &mkp RCLK       &mkp MCLK
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
